{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "vae_video": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "load": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "vesta_input.jpg"
    }
  },
  "cond": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["clip", 0],
      "vae": ["vae_video", 0],
      "first_frame": ["load", 0],
      "prompt": "VESTA_PROMPT",
      "width": 1344,
      "height": 768,
      "length": 243
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["unet", 0],
      "conditioning": ["cond", 0]
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["unet", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler_select", 0],
      "sigmas": ["sigmas", 0],
      "latent_image": ["cond", 1]
    }
  },
  "decode_video": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["vae_video", 0]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["decode_video", 0],
      "fps": 24
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["video", 0],
      "filename_prefix": "video/Vesta_H3_campaign-a",
      "format": "auto",
      "codec": "auto"
    }
  }
}
